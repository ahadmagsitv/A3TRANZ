<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. Without this the device never registers
	     with APNs, so Firebase can never issue an FCM token and nothing is
	     deliverable. `development` matches a debug build; a release/TestFlight
	     build needs `production`. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
