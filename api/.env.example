DATABASE_URL=postgres://a3:a3@localhost:5433/a3tranz
PORT=4000


# Firebase service account for push. Unset = no push; notification rows are
# still written and the Alerts tab still shows them.
FCM_CREDENTIALS=./secrets/firebase-service-account.json

# Cloudinary — media storage. The cloud name is in your Cloudinary dashboard
# (top-left, under the account name); it is part of every delivery URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Primary/Root secret — delivery URLs are validated against this one.
CLOUDINARY_DELIVERY_SECRET=
