DATABASE_URL=postgres://a3:a3@localhost:5433/a3tranz
PORT=4000

# Object storage (docker-compose `minio`). The endpoint must be reachable BY
# THE CLIENT, not just by the API: localhost works for the browser and the iOS
# simulator, a physical device needs this machine's LAN IP.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=a3tranz
S3_REGION=us-east-1
S3_ACCESS_KEY=a3minio
S3_SECRET_KEY=a3miniosecret
